# Copy to .env and fill in. Used by the `quant2`, `uploader` and `logwatch` services.

# --- Collector (quant2) — optional, defaults shown ---
# Base assets; each is collected as Kraken spot <ASSET>/USD and the linear
# perpetual PF_<ASSET>USD (BTC is PF_XBTUSD on futures).
ASSETS=btc,eth,sol,xrp,bnb
# Which Kraken markets to collect: spot, futures, or both.
MARKETS=spot,futures

# --- Uploader: required ---
S3_BUCKET=goglike

# --- Hetzner Object Storage (S3-compatible) ---
# Endpoint matches your bucket's location: fsn1 / nbg1 / hel1
S3_ENDPOINT_URL=https://nbg1.your-objectstorage.com
S3_REGION=nbg1

# Credentials are NOT set here. They are provided via a Docker secret —
# copy secrets/s3_credentials.example to secrets/s3_credentials and fill it in.

# --- Optional ---
# Key prefix inside the bucket. Keys mirror the path under DATA_DIR, so with an
# empty prefix: kraken/spot/btc_usd/depth10_tick_20261027.csv. (The old Binance
# files live under btcusdt/ — don't reuse that prefix.)
S3_PREFIX=
# Set to "true" if your provider needs path-style addressing
S3_FORCE_PATH_STYLE=false
# Seconds between sync passes
UPLOAD_INTERVAL_SECS=300
# Delete local finalized files older than this many days (after they're in the
# bucket). 0 or unset disables local pruning.
RETENTION_DAYS=7

# --- logwatch (observability sidecar) ---
# Get a bot token from @BotFather (/newbot). Then message your bot once and open
#   https://api.telegram.org/bot<token>/getUpdates
# to find your chat id (the "chat":{"id":...} value).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional external dead-man's switch. Create a check at healthchecks.io (or
# Better Stack) and paste its ping URL here. logwatch pings it every 60s while
# healthy and <url>/fail while an alert is active, so you're notified even if the
# whole host or this sidecar dies. Leave empty to disable.
HEALTHCHECK_URL=

# --- Optional tuning (defaults shown) ---
# Alert if no "Flush tick" line from the collector for this many seconds.
FLUSH_MAX_SILENCE_SECS=30
# Alert if the collector's "total depth=" counter stops advancing this long
# (connected to Binance but receiving no data).
COUNTER_MAX_STALE_SECS=60
# Alert if no "sync pass complete" from the uploader for this many seconds
# (set to ~3x UPLOAD_INTERVAL_SECS).
UPLOADER_MAX_SILENCE_SECS=900
# Minimum seconds between repeats of the same alert (debounce).
ALERT_COOLDOWN_SECS=300
# Suppress all alerts for this many seconds after startup.
STARTUP_GRACE_SECS=60
# Periodic "🟢 all healthy" confirmation to Telegram, so silence means "fine"
# rather than "logwatch is broken". Skipped while any alert is active. 0 disables.
# Default 21600 = every 6h.
HEALTHY_PING_SECS=21600

# Diagnostics for logwatch only (doesn't affect collector/uploader log levels).
# logwatch=debug  -> container discovery, heartbeat parsing, staleness checks
# logwatch=trace  -> also every raw log line logwatch reads from the containers
LOGWATCH_LOG=logwatch=info
